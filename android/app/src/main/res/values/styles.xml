<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Status bar matches the app's dark background so the icons stay light and readable. -->
    <color name="status_bar">#0A101D</color>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- Behind the WebView's first paint: the same ground the boot sticker uses. -->
        <item name="android:windowBackground">@color/boot_ground</item>
        <item name="android:statusBarColor">@color/status_bar</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>


    <!-- Quick add card: a dimmed, translucent window over the launcher. Never the full app. -->
    <style name="QuickAddTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.55</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowSoftInputMode">stateVisible|adjustResize</item>
    </style>

    <!-- Launch window: one flat ground colour, no seam into the boot sticker. The screen ignores
         this and paints the queue the moment it is ready. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@color/boot_ground</item>
        <item name="android:windowBackground">@color/boot_ground</item>
        <item name="android:statusBarColor">@color/boot_ground</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>